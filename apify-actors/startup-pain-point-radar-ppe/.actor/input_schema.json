    "minPainScore": {
      "title": "Minimum heuristic pain score",
      "type": "integer",
      "editor": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 45,
      "description": "Minimum heuristic pain score.",
      "prefill": 45
